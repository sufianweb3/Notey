{
  "name": "notey",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"vite\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/entry/node.ts",
    "build": "pnpm build:web && pnpm build:node && pnpm build:cf && wrangler deploy -c wrangler.gateway.jsonc --dry-run --outdir dist/gateway",
    "build:web": "vite build",
    "build:node": "tsx scripts/build-node.ts",
    "build:cf": "wrangler deploy --dry-run --outdir dist/cf",
    "build:vercel": "pnpm build:web && tsx scripts/build-vercel.ts",
    "start": "node dist/server/node.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate && tsx scripts/bundle-migrations.ts",
    "deploy:cf": "pnpm build:web && wrangler deploy",
    "deploy:vercel": "vercel deploy --prod",
    "smoke": "tsx scripts/smoke.ts",
    "design:lint": "node node_modules/@google/design.md/dist/index.js lint DESIGN.md",
    "design:tokens": "node node_modules/@google/design.md/dist/index.js export --format css-tailwind DESIGN.md > src/web/styles/tokens.css",
    "deploy:gateway": "wrangler deploy -c wrangler.gateway.jsonc"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "@tailwindcss/oxide",
      "libsql",
      "sharp"
    ]
  },
  "dependencies": {
    "@blocknote/code-block": "0.57.0",
    "@blocknote/core": "0.57.0",
    "@blocknote/react": "0.57.0",
    "@blocknote/shadcn": "0.57.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@vercel/blob": "^2.9.0",
    "better-auth": "^1.7.27",
    "chrono-node": "^2.10.3",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "katex": "^0.19.1",
    "lucide-react": "^1.78.0",
    "marked": "^18.2.1",
    "mermaid": "^12.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@eslint/js": "^10.0.1",
    "@google/design.md": "0.4.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "~8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
